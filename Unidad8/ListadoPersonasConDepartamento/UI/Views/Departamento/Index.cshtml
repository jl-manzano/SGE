@model List<Domain.Entities.Departamento>

@{
    ViewData["Title"] = "Listado de Departamentos";
}

<h1>@ViewData["Title"]</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">Crear Nuevo Departamento</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th style="text-align:center;">ID</th>
            <th style="text-align:center;">Nombre</th>
            <th style="text-align:center;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var departamento in Model)
        {
            <tr>
                <!-- Mostrar ID del departamento -->
                <td align="center" style="vertical-align:middle">@departamento.IdDepartamento</td>
                <!-- Mostrar nombre del departamento -->
                <td align="center" style="vertical-align:middle">@departamento.NombreDepartamento</td>
                <td align="center" style="vertical-align:middle">
                    <!-- Botones de acción -->
                    @Html.ActionLink("Editar", "Edit", new { id = departamento.IdDepartamento }) |
                    @Html.ActionLink("Detalles", "Details", new { id = departamento.IdDepartamento }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = departamento.IdDepartamento })
                </td>
            </tr>
        }
    </tbody>
</table>
