@model Domain.DTOs.PersonaWithNombreDepartamentoDTO

@{
    ViewData["Title"] = "Eliminar Persona";
}

<h1>@ViewData["Title"]</h1>

<p>¿Estás seguro de que deseas eliminar a la persona: <strong>@Model.persona.Nombre @Model.persona.Apellidos</strong>?</p>

<form method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button> |
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
